{
  "name": "chat",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "CHAT_KV",
      "id": "3f48e77d245f41bfa2fbc1852bf7c98b"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "API_KEY": "",
    "APP_VERSION_CODE": "1",
    "APP_VERSION_NAME": "1.0",
    "APP_DOWNLOAD_URL": "https://download.l.zztxer.dpdns.org/1.0-app-debug.apk",
    "APP_CHANGELOG": "【新增】更新功能",
    "APP_FORCE_UPDATE": "false",
    "APP_MIN_SDK": "24",
    "WIN_VERSION_CODE": "1",
    "WIN_VERSION_NAME": "1.0",
    "WIN_DOWNLOAD_URL": "https://download.l.zztxer.dpdns.org/1.0-AI_Chat-Setup-x64",
    "WIN_CHANGELOG": "【新增】更新功能",
    "WIN_FORCE_UPDATE": "false"
  }
}
